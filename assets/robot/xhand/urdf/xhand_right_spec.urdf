<?xml version="1.0"?>
<!-- xhand right, corrected against the RobotEra X-Hand 1 Product Manual V1.0.
     (1) index bend/proximal collision+visual geometry taken from Dex4D
         (fr3_xhand.urdf) and mapped into our link frames;
     (2) joints 0-3 limits set to the manual's table. Joint 3 is asymmetric and
         our axis sign is inverted vs the manual, so its range is mirrored.
     Kinematics, inertials and every other link are unchanged from
     xhand_right.urdf. Generated by scratchpad/make_dex4d_index.py. -->
